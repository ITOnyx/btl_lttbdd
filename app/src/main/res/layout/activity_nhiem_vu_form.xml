<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Thanh tiêu đề Toolbar: neo trên cùng -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarNhiemVuForm"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Thông tin nhiệm vụ"
        app:titleTextColor="@color/white" />

    <!-- ScrollView chiếm phần còn lại dưới Toolbar -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarNhiemVuForm">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Tên nhiệm vụ -->
            <TextView
                android:id="@+id/lblTenNhiemVu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên nhiệm vụ (*)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/edtTenNhiemVu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:hint="Nhập tên nhiệm vụ..."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblTenNhiemVu" />

            <!-- Ghi chú nhiệm vụ -->
            <TextView
                android:id="@+id/lblGhiChu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Ghi chú chi tiết"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtTenNhiemVu" />

            <EditText
                android:id="@+id/edtGhiChu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:gravity="top"
                android:hint="Nhập ghi chú yêu cầu..."
                android:lines="3"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblGhiChu" />

            <!-- Hạn hoàn thành: ô nhập co giãn, nút "Chọn" neo mép phải -->
            <TextView
                android:id="@+id/lblHanHoanThanh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Hạn hoàn thành (yyyy-MM-dd)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtGhiChu" />

            <EditText
                android:id="@+id/edtHanHoanThanh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:focusable="false"
                android:hint="Chọn ngày hạn nộp..."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/btnChonHanHoanThanh"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblHanHoanThanh" />

            <Button
                android:id="@+id/btnChonHanHoanThanh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Chọn"
                app:layout_constraintBottom_toBottomOf="@id/edtHanHoanThanh"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/edtHanHoanThanh" />

            <!-- Barrier: lấy mép dưới của view thấp nhất trong hàng (ô nhập hoặc nút) -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierHanHoanThanh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="edtHanHoanThanh,btnChonHanHoanThanh" />

            <!-- Các nút hành động -->
            <Button
                android:id="@+id/btnLuuNhiemVu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/primary"
                android:padding="14dp"
                android:text="Lưu nhiệm vụ"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierHanHoanThanh" />

            <Button
                android:id="@+id/btnQuayLaiNhiemVu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="14dp"
                android:text="Quay lại"
                android:textColor="@color/primary"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnLuuNhiemVu" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
