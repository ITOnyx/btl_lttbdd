<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Thanh tiêu đề Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarNhiemVuForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Thông tin nhiệm vụ"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tên nhiệm vụ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên nhiệm vụ (*)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTenNhiemVu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:hint="Nhập tên nhiệm vụ..."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Ghi chú nhiệm vụ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú chi tiết"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtGhiChu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:gravity="top"
                android:hint="Nhập ghi chú yêu cầu..."
                android:lines="3"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Hạn hoàn thành -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hạn hoàn thành (yyyy-MM-dd)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtHanHoanThanh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/surface"
                    android:focusable="false"
                    android:hint="Chọn ngày hạn nộp..."
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnChonHanHoanThanh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Chọn" />
            </LinearLayout>

            <!-- Các nút hành động -->
            <Button
                android:id="@+id/btnLuuNhiemVu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:padding="14dp"
                android:text="Lưu nhiệm vụ"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnQuayLaiNhiemVu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="14dp"
                android:text="Quay lại"
                android:textColor="@color/primary"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
