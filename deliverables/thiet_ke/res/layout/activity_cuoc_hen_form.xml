<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Thanh tiêu đề Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCuocHenForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Thông tin cuộc hẹn"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tiêu đề cuộc hẹn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiêu đề cuộc hẹn (*)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTieuDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:hint="VD: Báo cáo tiến độ tuần 3..."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Thời gian (ngày & giờ) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian gặp (* yyyy-MM-dd HH:mm)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtThoiGian"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/surface"
                    android:focusable="false"
                    android:hint="Chọn ngày và giờ..."
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnChonThoiGian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Chọn Lịch" />
            </LinearLayout>

            <!-- Địa điểm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa điểm cuộc hẹn"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDiaDiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:hint="VD: Phòng Lab 501 / Google Meet..."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Ghi chú chi tiết -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú / Nội dung trao đổi"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtGhiChu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/surface"
                android:gravity="top"
                android:hint="Nhập nội dung cần chuẩn bị trước..."
                android:lines="3"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Nút Lưu & Quay lại -->
            <Button
                android:id="@+id/btnLuuCuocHen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:padding="14dp"
                android:text="Lưu cuộc hẹn"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnQuayLaiCuocHen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="14dp"
                android:text="Quay lại"
                android:textColor="@color/primary"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
