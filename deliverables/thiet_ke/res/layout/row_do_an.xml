<?xml version="1.0" encoding="utf-8"?>
<!-- Layout một dòng hiển thị thông tin Đồ án (thích ứng tốt cả cuộn dọc 1 cột và lưới 2 cột) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_do_an"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <!-- ConstraintLayout phẳng: mọi view nằm cùng một cấp, vị trí xác định bằng ràng buộc -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Tiêu đề đồ án: co giãn giữa mép trái và nút Sửa -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:minHeight="32dp"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            app:layout_constraintEnd_toStartOf="@id/btn_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hệ thống Theo dõi Tiến độ Đồ án" />

        <!-- Nút Sửa / Xóa căn giữa theo chiều dọc với tiêu đề -->
        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_project"
            android:padding="5dp"
            android:src="@drawable/ic_edit"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toStartOf="@id/btn_delete"
            app:layout_constraintTop_toTopOf="@id/tv_title"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_project_title"
            android:padding="5dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_title"
            app:tint="@color/status_expired" />

        <!-- Mô tả ngắn gọn về đề tài (có thể GONE) -->
        <TextView
            android:id="@+id/tv_mo_ta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:text="Mô tả tóm tắt về đề tài nghiên cứu và phát triển phần mềm" />

        <!-- Dòng thông tin Giảng viên hướng dẫn -->
        <ImageView
            android:id="@+id/iv_giang_vien"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_person"
            app:layout_constraintBottom_toBottomOf="@id/tv_giang_vien"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_giang_vien"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tv_giang_vien"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_giang_vien"
            app:layout_constraintTop_toBottomOf="@id/tv_mo_ta"
            tools:text="GVHD: TS. Nguyễn Văn A" />

        <!-- Dòng thông tin Thời gian / Hạn nộp -->
        <ImageView
            android:id="@+id/iv_thoi_gian"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar"
            app:layout_constraintBottom_toBottomOf="@id/tv_thoi_gian"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_thoi_gian"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tv_thoi_gian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_thoi_gian"
            app:layout_constraintTop_toBottomOf="@id/tv_giang_vien"
            tools:text="Hạn: 2026-06-30" />

        <!-- Đường kẻ phân cách -->
        <View
            android:id="@+id/view_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_thoi_gian" />

        <!-- Nhãn và phần trăm tiến độ thực hiện (căn theo đường chân chữ - baseline) -->
        <TextView
            android:id="@+id/tv_label_tien_do"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/project_progress"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/tv_tien_do"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_divider" />

        <TextView
            android:id="@+id/tv_tien_do"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textSize="12.5sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_label_tien_do"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="3/5 (60%)" />

        <!-- Thanh ProgressBar trực quan -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/custom_progress_drawable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_tien_do"
            tools:progress="60" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
